build/
doc/api/
validation_runs/

vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/*.vsix
vscode-extension/src/**/*.js
vscode-extension/src/**/*.js.map
# Staged-on-publish copies of root-level README/LICENSE/schemas — see stage-docs script
vscode-extension/README.md
vscode-extension/LICENSE
vscode-extension/schemas/

.DS_Store
.env*
!test/fixtures/**/.env
!test/fixtures/**/.env.*
!test/fixtures/**/config/.env.*

# Scanner-generated run artefacts.
.sast-telemetry.json
.sast-baseline.json

# Rust engine build artifacts (the engine itself is now tracked — see BLUEPRINT_RUST_ENGINE.md).
engine/target/
engine/Cargo.lock

# engine-cli binaries bundled into the .vsix at packaging time. Built
# locally via `vscode-extension/scripts/bundle-engine.sh` (host-only by
# default), or per-release by `.github/workflows/release-binaries.yml`
# for all three supported triples. Not tracked in git because they're
# 4 MB each and cargo-built artifacts shouldn't live in version control.
vscode-extension/bin/


